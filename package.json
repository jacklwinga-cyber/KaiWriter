    "@lexical/rich-text": "^0.45.0",
    "@lexical/selection": "^0.45.0",
    "@lexical/table": "^0.45.0",
    "@lexical/utils": "^0.45.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tauri-apps/api": "^2.11.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lexical": "^0.45.0",
    "lucide-react": "^1.17.0",
    "mammoth": "1.12.0",
