# KaiWriter — copy to .env.local and fill in values

# Production canonical URL (Vercel: set in Production env)
# Local dev can omit — app uses window.location.origin
VITE_SITE_URL=https://kaiwriter.kainoter.com

# Cross-app URLs (optional — defaults shown)
VITE_KAIWRITER_URL=https://kaiwriter.kainoter.com
VITE_KAIHUB_URL=https://hub.kainoter.com
# VITE_APP_MODE=hub   # force KaiHub routes locally (or use /hub on writer host)

# Supabase (auth + cloud sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
#
# Enable Google OAuth in Supabase Dashboard → Authentication → Providers → Google
# Add redirect URLs (Authentication → URL Configuration):
#   https://kaiwriter.kainoter.com/app
#   http://localhost:5173/app

# Stripe (server — for npm run setup:stripe only, never commit live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (optional if webhook already exists)

# Stripe (client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: AI writing suggestions (Supabase Edge Function secret, not client-side)
# ANTHROPIC_API_KEY=sk-ant-...
